{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promo-remind",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PROMOS",
      "id": "GANTI_DENGAN_ID_KV"
    }
  ]
}
